
import random

print("==========================================")
print("          PYTHON DICE SIMULATOR")
print("==========================================")

# Initialize variables
total_rolls = 0
continue_game = True

# Dice simulator function
def roll_dice():

    number = random.randint(1, 6)

    print("\nYou rolled:", number)

    # Display dice face
    if number == 1:
        print("+-------+")
        print("|       |")
        print("|   *   |")
        print("|       |")
        print("+-------+")

    elif number == 2:
        print("+-------+")
        print("| *     |")
        print("|       |")
        print("|     * |")
        print("+-------+")

    elif number == 3:
        print("+-------+")
        print("| *     |")
        print("|   *   |")
        print("|     * |")
        print("+-------+")

    elif number == 4:
        print("+-------+")
        print("| *   * |")
        print("|       |")
        print("| *   * |")
        print("+-------+")

    elif number == 5:
        print("+-------+")
        print("| *   * |")
        print("|   *   |")
        print("| *   * |")
        print("+-------+")

    elif number == 6:
        print("+-------+")
        print("| *   * |")
        print("| *   * |")
        print("| *   * |")
        print("+-------+")

    return number


# Main program
while continue_game:

    print("\n========== DICE MENU ==========")

    print("1. Roll Dice")
    print("2. Roll Dice Multiple Times")
    print("3. Display Total Rolls")
    print("4. Exit")

    choice = input("\nEnter your choice: ")

    if choice == "1":

        roll_dice()
        total_rolls += 1

    elif choice == "2":

        count = int(input("How many times do you want to roll? "))

        if count <= 0:
            print("Enter a positive number!")

        else:
            for i in range(count):

                print("\nRoll Number:", i + 1)

                roll_dice()
                total_rolls += 1

    elif choice == "3":

        print("\nTotal Dice Rolls:", total_rolls)

    elif choice == "4":

        print("\nThank you for playing Dice Simulator!")
        print("Total Dice Rolls:", total_rolls)

        continue_game = False

    else:

        print("\nInvalid choice! Please try again.")

print("==========================================")
