print("       PRIME NUMBER PROGRAM")
print("===================================")

# Get input from the user
num = int(input("Enter a number: "))

# Check whether the number is prime
if num <= 1:
    print(num, "is not a prime number")

else:
    count = 0

    for i in range(1, num + 1):
        if num % i == 0:
            count = count + 1

    if count == 2:
        print(num, "is a prime number")
    else:
        print(num, "is not a prime number")

print("===================================")
